{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Invoice extraction",
  "type": "object",
  "required": ["invoice", "supplier", "total", "currency", "lines"],
  "properties": {
    "invoice": {"type": "string", "pattern": "^INV-[0-9]+$", "examples": ["INV-1042"]},
    "supplier": {"type": "string", "minLength": 1},
    "total": {"type": "number", "exclusiveMinimum": 0},
    "currency": {"enum": ["GBP", "EUR", "USD"]},
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item", "amount"],
        "properties": {
          "item": {"type": "string"},
          "amount": {"type": "number"}
        }
      }
    }
  }
}
