{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ticket triage",
  "type": "object",
  "required": ["category", "severity", "summary", "actions"],
  "properties": {
    "category": {"enum": ["billing", "technical", "account"]},
    "severity": {"enum": ["high", "medium", "low"], "description": "high escalates to the on-call engineer"},
    "summary": {"type": "string", "minLength": 1, "examples": ["Invoice total does not match the order"]},
    "refund": {"type": "number", "minimum": 0},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "required": ["owner", "step"],
      "properties": {
        "owner": {"enum": ["support", "engineering", "finance"]},
        "step": {"type": "string", "minLength": 1}
      }
    }
  }
}
