{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QA test plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["tests", "exclusions", "coverage_gaps", "open_questions"],
  "properties": {
    "tests": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/test"}
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "reason"],
        "properties": {
          "area": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "coverage_gaps": {"$ref": "#/$defs/notes"},
    "open_questions": {"$ref": "#/$defs/notes"}
  },
  "anyOf": [
    {"properties": {"tests": {"minItems": 1}}},
    {"properties": {"exclusions": {"minItems": 1}}}
  ],
  "$defs": {
    "notes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "category", "requirement_refs", "scenario", "preconditions",
        "steps", "expected_outcome", "priority"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"enum": ["functional", "negative", "security", "api", "exploratory"]},
        "requirement_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REQ-[0-9]{3,}$"}
        },
        "scenario": {"type": "string", "minLength": 1},
        "preconditions": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_outcome": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2", "P3"]}
      }
    }
  }
}
