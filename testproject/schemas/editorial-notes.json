{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editorial notes from one specialist reader",
  "type": "object",
  "additionalProperties": false,
  "required": ["focus", "summary", "strengths", "issues", "questions_for_author"],
  "properties": {
    "focus": {"enum": ["structure", "character", "prose", "continuity", "market"]},
    "summary": {"type": "string", "minLength": 1},
    "strengths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "location"],
        "properties": {
          "point": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "location", "evidence", "why_it_matters", "suggestion"],
        "properties": {
          "id": {"type": "string", "pattern": "^(STR|CHR|PRO|CON|MKT)-[0-9]{2,}$"},
          "severity": {"enum": ["major", "moderate", "minor"]},
          "location": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "suggestion": {"type": "string", "minLength": 1}
        }
      }
    },
    "questions_for_author": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
